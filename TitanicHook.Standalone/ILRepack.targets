<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">	  
  <!-- ILRepack -->
  <Target Name="ILRepacker" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(TargetFramework)' != ''">
    <PropertyGroup>
      <OutputAssembly>$(OutputPath)$(AssemblyName).exe</OutputAssembly>
      <OutputMergedAssembly>$(OutputPath)Titanic!.exe</OutputMergedAssembly>
    </PropertyGroup>

    <ItemGroup>
      <AssembliesToMerge Include="$(OutputAssembly)" />
      <AssembliesToMerge Include="$(TargetDir)TitanicHook.Loader.dll" />
      <AssembliesToMerge Include="$(TargetDir)TitanicHook.Core.dll" />
      <AssembliesToMerge Include="$(TargetDir)0Harmony.dll" />
      <AssembliesToMerge Include="$(TargetDir)ILReader.dll" />
      <AssembliesToMerge Include="$(TargetDir)TitanicHook.PluginBase.dll" />
      <AssembliesToMerge Include="$(TargetDir)LinqBridge.dll" Condition="'$(TargetFramework)' == 'net20'" />
    </ItemGroup>

    <ILRepack
      Parallel="true"
      AllowedDuplicateNamespaces="$(ILRepackAllowedDuplicateNamespaces)"
      InputAssemblies="@(AssembliesToMerge)"
      TargetKind="WinExe"
      OutputFile="$(OutputMergedAssembly)"
    />
  </Target>
  <!-- /ILRepack -->
</Project>
