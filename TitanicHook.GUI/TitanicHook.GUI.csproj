<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net20;net40</TargetFrameworks>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>13</LangVersion>
		<PlatformTarget>x86</PlatformTarget>
		<ApplicationIcon>titanic.ico</ApplicationIcon>
		<DefineConstants>$(DefineConstants);GUI</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\TitanicHook.Loader\Program.cs" Link="Loader\Program.cs" />
		<Compile Include="..\TitanicHook.Loader\PreLaunchChecks.cs" Link="Loader\PreLaunchChecks.cs" />
		<Compile Include="..\TitanicHook.Loader\OsuStartHook.cs" Link="Loader\OsuStartHook.cs" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<ProjectReference Include="..\TitanicHook.Core\TitanicHook.Core.csproj" />
		<Reference Include="System" />
		<Reference Include="System.Data" />
		<Reference Include="System.Deployment" />
		<Reference Include="System.Drawing" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Xml" />
  </ItemGroup>
</Project>
