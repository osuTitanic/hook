<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net20;net40</TargetFrameworks>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>13</LangVersion>
		<PlatformTarget>x86</PlatformTarget>
		<Version>1.2.0</Version>
		<Company>Titanic!</Company>
		<ApplicationIcon>titanic.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.43" />
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
		<ProjectReference Include="..\TitanicHook.Core\TitanicHook.Core.csproj" />
		<ProjectReference Include="..\TitanicHook.Loader\TitanicHook.Loader.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<Reference Include="System" />
		<Reference Include="System.Data" />
		<Reference Include="System.Deployment" />
		<Reference Include="System.Drawing" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Xml" />
	</ItemGroup>
	
	<PropertyGroup Condition="'$(TargetFramework)' == 'net40'">
		<AssemblyTitle>Titanic!</AssemblyTitle>
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(TargetFramework)' == 'net20'">
		<AssemblyTitle>Titanic! (fallback)</AssemblyTitle>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<PlatformTarget>x86</PlatformTarget>
		<Prefer32bit>true</Prefer32bit>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<PlatformTarget>x86</PlatformTarget>
		<Prefer32bit>true</Prefer32bit>
	</PropertyGroup>

	<Import Project="ILRepack.targets" />
	<Import Project="SignAssembly.targets" />
</Project>