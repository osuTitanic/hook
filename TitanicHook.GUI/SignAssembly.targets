<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SignAssemblyAfterBuild>false</SignAssemblyAfterBuild>
    <CertificateName>Open Source Developer</CertificateName>
    <TimeServerUrl>http://time.certum.pl</TimeServerUrl>
    <SignToolPath>signtool.exe</SignToolPath>
  </PropertyGroup>

  <Target Name="SignMergedAssembly"
    AfterTargets="ILRepacker"
    Condition="'$(SignAssemblyAfterBuild)' == 'true'
                   And '$(Configuration)' == 'Release'
                   And '$(IsCrossTargetingBuild)' != 'true'">
                   
    <Error Condition="'$(OutputMergedAssembly)' == '' Or !Exists('$(OutputMergedAssembly)')"
      Text="ILRepack output is missing. OutputMergedAssembly='$(OutputMergedAssembly)'." />

    <Message Text="Signing $(OutputMergedAssembly)" Importance="high" />

    <Exec
      Command='"$(SignToolPath)" sign /n "$(CertificateName)" /fd sha256 /tr "$(TimeServerUrl)" /td sha256 /v "$(OutputMergedAssembly)"' />
  </Target>
</Project>